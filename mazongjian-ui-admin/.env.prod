# 生产环境配置
NODE_ENV = 'production'

# 页面标题
VUE_APP_TITLE = 无人自助管理系统

# 无人自助管理系统/生产环境
VUE_APP_BASE_API = '/prod-api'
# VUE_APP_BASE_API = '/'

# 根据服务器或域名修改
PUBLIC_PATH = '/'
# PUBLIC_PATH = 'https://admin.scyanzu.com'

# 二级部署路径
# VUE_APP_APP_NAME ='/'

# 多租户的开关
VUE_APP_TENANT_ENABLE = true

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = false

# 文档的开关
VUE_APP_DOC_ENABLE = false

# 百度统计
VUE_APP_BAIDU_CODE = 
