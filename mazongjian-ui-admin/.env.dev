# 开发环境配置
ENV = 'development'

# 页面标题
VUE_APP_TITLE = 无人自助管理系统

# 无人自助管理系统/开发环境
VUE_APP_BASE_API = 'https://wq.scyanzu.com'

PUBLIC_PATH = '/admin'

VUE_APP_APP_NAME ='/admin'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 多租户的开关
VUE_APP_TENANT_ENABLE = true

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = false

# 文档的开关
VUE_APP_DOC_ENABLE = false

# 百度统计
VUE_APP_BAIDU_CODE =
