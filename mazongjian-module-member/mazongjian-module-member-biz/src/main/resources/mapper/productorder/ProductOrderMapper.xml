<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yanzu.module.member.dal.mysql.productorder.ProductOrderMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <select id="selectByOrderNo" resultType="com.yanzu.module.member.dal.dataobject.productorder.ProductOrderDO" parameterType="String">
        select * from member_product_order
        where order_no = #{orderNo}
    </select>

    <update id="updateByOrderNo" parameterType="String">
        update member_product_order
        set status = 3
        where order_no = #{orderNo}
    </update>

    <select id="selectHaveOrderStore" parameterType="Long" resultType="com.yanzu.module.member.controller.app.productorder.vo.AppHaveOrderStoreRespVO">
        select distinct s.store_id , s.store_name
        from member_product_order o
        left join member_store_info s on s.store_id = o.store_id
        where o.user_id = #{userId}
    </select>

    <select id="getPhone" resultType="String" parameterType="Long">
        select user_phone
        from member_product_order
        where deleted = 0
        and order_id = #{orderId}
    </select>
    <resultMap id="OrderPageResultMap" type="com.yanzu.module.member.controller.app.productorder.vo.AppUserOrderPageRespVO">
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="store_id" property="storeId"/>
        <result column="total_price" property="totalPrice"/>
        <result column="pay_price" property="payPrice"/>
        <result column="pay_time" property="payTime"/>
        <result column="status" property="status"/>
        <result column="product_info" property="productInfoJson"/>
        <result column="mark" property="mark"/>
        <result column="pay_type" property="payType"/>
        <result column="create_time" property="createTime"/>

        <!--        <result column="room_name" property="roomName"/>-->
        <!--        <result column="nickname" property="userName"/>-->
        <!--        <result column="mobile" property="userPhone"/>-->
    </resultMap>
    <select id="userOrderByPage"
           resultType="com.yanzu.module.member.controller.app.productorder.vo.AppUserOrderPageRespVO">
        select
        o.order_id,
        o.order_no,
        o.store_id,
        o.total_price,
        o.pay_price,
        o.pay_time,
        o.status,
        o.product_info  productInfoJson,
        o.mark,
        o.pay_type,
        r.room_name,
        u.nickname userName,
        u.mobile userPhone,
        o.create_time
        from member_product_order o
        left join member_room_info r ON r.room_id = o.room_id
        left join member_user u ON u.id = o.user_id
        where o.deleted = 0
        AND o.user_id=#{userId}
        <if test="null!=reqVO">
            <if test="null!=reqVO.storeId and ''!=reqVO.storeId">
                o.store_id=#{reqVO.storeId}
            </if>
            <if test="null!=reqVO.status and ''!=reqVO.status">
                o.status=#{reqVO.status}
            </if>
        </if>
        order by o.create_time desc
    </select>
</mapper>
